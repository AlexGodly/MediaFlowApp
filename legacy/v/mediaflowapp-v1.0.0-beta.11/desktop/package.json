{
  "name": "mediaflow-desktop",
  "productName": "MediaFlow",
  "version": "1.0.0-beta.11",
  "description": "MediaFlow by Alex Godly for Windows: the full MediaFlow website, packaged locally.",
  "author": "Alex Godly",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.alexgodly.mediaflow",
    "productName": "MediaFlow",
    "copyright": "Copyright © Alex Godly",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "www",
        "to": "www"
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MediaFlow",
      "artifactName": "MediaFlow-${version}-Windows-${arch}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "MediaFlow-${version}-Windows-${arch}-portable.${ext}"
    }
  }
}
